# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cms_dev?sslmode=disable

# Go API
API_HOST=0.0.0.0
API_PORT=8080
API_ENV=development
API_LOG_LEVEL=debug

# Auth (magic link)
MAGIC_LINK_SECRET=change_me_in_dev_use_long_random_string
SESSION_COOKIE_NAME=cms_session
SESSION_TTL_HOURS=720

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cms-assets-dev
R2_PUBLIC_URL=https://assets-dev.example.com

# Email (for magic links) — pick one provider
RESEND_API_KEY=
EMAIL_FROM=hello@example.com

# Editor (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXTAUTH_SECRET=

# Renderer (Astro)
RENDERER_API_BASE_URL=http://localhost:8080
RENDERER_SNAPSHOT_TOKEN=internal_service_token_change_me

# TLS edge gateway (apps/edge) — terminates HTTPS for subdomains + custom domains
TLS_MODE=selfsigned                       # selfsigned (dev) | acme (prod)
HTTPS_ADDR=:8443                          # :443 in prod
HTTP_ADDR=:8081                           # :80 in prod (ACME challenge + redirect)
RENDERER_UPSTREAM=http://localhost:4321
RESOLVE_API_BASE=http://localhost:8080
RESOLVE_TOKEN=dev_only_not_secret
# acme mode only:
ACME_EMAIL=
ACME_DIRECTORY=                           # LE staging URL while testing; blank = production
CERT_CACHE_DIR=./.certs
