# Copy to deploy/.env.prod and fill in. Never commit the real file.

# --- Postgres ---
POSTGRES_USER=cms
POSTGRES_PASSWORD=change_me_long_random
POSTGRES_DB=cms

# --- Shared internal service token (API ↔ edge ↔ renderer) ---
# Long random string. Gates /internal/* (resolve, snapshots, previews).
INTERNAL_TOKEN=change_me_long_random

# --- Platform domain ---
# Subdomains are {tenant}-{project}.${PLATFORM_DOMAIN}
PLATFORM_DOMAIN=cms.app

# API hostname — the edge serves the API over HTTPS here (forms/comments from
# published sites POST to it). Must have a DNS A record → gateway IP.
API_HOSTNAME=api.cms.app
# Browser-facing API origin (used by published sites for form/comment POSTs):
PUBLIC_API_BASE=https://api.cms.app
ASSET_PUBLIC_BASE=https://api.cms.app

# --- ACME / Let's Encrypt (edge) ---
ACME_EMAIL=ops@cms.app
# While testing, use LE staging to avoid rate limits (untrusted certs):
#   ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
# Leave BLANK for real (production) certificates:
ACME_DIRECTORY=
