---
import { sectionShell, type SectionStyle } from "../style";

interface FaqItem {
  question: string;
  answer: string;
}
interface Slots {
  eyebrow?: string;
  headline?: string;
  items: FaqItem[];
}
interface Variants {
  background?: "white" | "gray";
}
interface Props {
  slots: Slots;
  variants?: Variants;
  style?: SectionStyle;
}

const { slots, variants = {}, style } = Astro.props;
const bg = variants.background ?? "white";
const bgClass = bg === "gray" ? "bg-surface" : "bg-white";
const { sectionClass, sectionStyle } = sectionShell({ bgClass, defaultPadding: "lg" }, style);
---
<section class={sectionClass} style={sectionStyle}>
  <div class="mx-auto max-w-3xl">
    {(slots.eyebrow || slots.headline) && (
      <header class="mb-12 text-center">
        {slots.eyebrow && (
          <p class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
            {slots.eyebrow}
          </p>
        )}
        {slots.headline && (
          <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">
            {slots.headline}
          </h2>
        )}
      </header>
    )}
    <div class="divide-y divide-line border-y border-line">
      {slots.items.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
            <h3 class="text-lg font-medium leading-snug">{item.question}</h3>
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-line text-muted transition-transform group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <p class="mt-3 text-base leading-relaxed text-muted">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
